        "messages": {
          "messageValues": [
            {
              "message": " You are Harbor Support's AI assistant.  Analyze the customer's message and return ONLY valid JSON.  Include these fields: {   \"intent\": \"billing, bug, account, technical, or other\",   \"urgency\": \"high, medium, or low\",   \"reply\": \"A helpful response to the customer\",   \"escalated\": true or false }  Rules: - Urgent complaints involving fraud, duplicate charges, or hacked accounts: high urgency and escalated true. - Bugs and technical issues: medium urgency. - Routine questions: low urgency. - Give a helpful, natural response. - Return JSON only. No Markdown."
            }
          ]
        },
        "batching": {}
      },
      "id": "b42079b5-2b81-4b35-bcb9-8f6d541fab2a",
