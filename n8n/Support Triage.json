    {
      "parameters": {
        "jsCode": "\nconst input = $input.first().json;\n\nconst raw = input.text || input.output || \"\";\nconst clean = raw.replace(/```json|```/g, \"\").trim();\n\nlet d;\n\ntry {\n  d = JSON.parse(clean);\n} catch (e) {\n  d = {\n    intent: \"other\",\n    urgency: \"medium\",\n    reply: \"Sorry, I am having trouble analysing your message right now. Please try again in a moment.\",\n    escalated: false\n  };\n}\n\nconst webhook = $(\"Webhook\").first().json.body || {};\n\nreturn [{\n  json: {\n    message: webhook.message || \"\",\n    session_id: webhook.sessionId || \"default-session\",\n    user_email: webhook.userEmail || \"\",\n    intent: d.intent || \"other\",\n    urgency: d.urgency || \"medium\",\n    reply: d.reply || \"\",\n    escalated: d.escalated === true || d.escalated === \"true\"\n  }\n}];\n"
      },
